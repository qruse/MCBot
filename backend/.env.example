APP_ENV=development
MARKET_DATA_PROVIDER=toss
# One backend worker. Defaults: backend/.paper and runtime/agent_exchange.
# PAPER_DB_PATH=
# PAPER_EXCHANGE_PATH=
PAPER_BACKGROUND_ENABLED=true
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
FRONTEND_ORIGIN=http://localhost:3001
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mcbot
MONGO_TIMEOUT_MS=2000
KIS_ENV=paper
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=your-8-digit-account-number
KIS_ACCOUNT_PRODUCT_CODE=01
MARKET_DATA_REFRESH_SECONDS=30
MARKET_DATA_SCHEDULER_ENABLED=false
STARTUP_GAP_FILL_ENABLED=false
